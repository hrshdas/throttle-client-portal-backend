# ── Throttle Backend — Environment Variables Example ──────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# Async PostgreSQL connection string: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://throttle:throttle123@localhost:5432/throttle

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Secret key used for signing JWT tokens (minimum 64 characters in production)
# Generate: python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=dev-secret-key-change-in-production-minimum-64-chars-long-xxxx
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App Configuration ─────────────────────────────────────────────────────────
# Environment mode: "development" | "production" | "testing"
ENVIRONMENT=development
# URL of the frontend application — used for CORS and OAuth redirect origins
FRONTEND_URL=http://localhost:8080

# ── SMTP Email (Optional) ─────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# ── Meta Marketing API Integration ───────────────────────────────────────────
# Required for real Meta Ads integration.
# See docs/integrations.md for step-by-step Meta App Dashboard configuration.
#
# 1. Create a Meta App at https://developers.facebook.com/apps/
# 2. Add "Marketing API" product
# 3. Request ads_read and ads_management permissions
# 4. Register the redirect URI below in "Valid OAuth Redirect URIs"
META_APP_ID=placeholder_meta_app_id
META_APP_SECRET=placeholder_meta_app_secret

# Meta Graph API version — update as Meta releases new versions (e.g. v26.0)
META_API_VERSION=v26.0

# OAuth redirect URI — must match "Valid OAuth Redirect URIs" in Meta App Dashboard
META_REDIRECT_URI=http://localhost:8000/api/v1/meta/connect/callback

# Dedicated encryption key for Meta access tokens stored in the database.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty, the system derives a key from SECRET_KEY.
META_ENCRYPTION_KEY=

# How many days of historical Meta data to sync on first connection (default: 30)
META_HISTORICAL_DAYS=30

# How often to run background sync in minutes (default: 30)
META_SYNC_INTERVAL_MINUTES=30
